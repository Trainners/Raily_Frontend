{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://organized-exercise-nonprofit-ping.trycloudflare.com/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}